# ==============================================================================
# SutrAI Phase 3 — Environment Configuration Template
# Tagline: "Every signal has a next step."
# ==============================================================================
# Copy this file to `.env` and configure your credentials.
# NEVER commit your actual `.env` file containing secrets to version control.

# --- Core Server Configuration ---
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Google Gemini AI Configuration ---
# Required for live server-side multimodal reasoning, claim extraction, and action routing.
# Get your API key at: https://aistudio.google.com
# If not provided, SutrAI seamlessly runs in resilient deterministic demo mode.
GEMINI_API_KEY=
# Configurable model (defaults to: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# --- Supabase PostgreSQL Database & Storage Configuration ---
# Required for live cloud database persistence, auth, and private evidence storage.
# Find these in your Supabase project dashboard -> Settings -> API.
# If not provided, SutrAI uses its built-in resilient in-memory store.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only (never exposed to client browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Open-Meteo Weather & Severe Hazard Intelligence ---
# Open-Meteo runs out-of-the-box with NO API KEY required (WMO global standard).
# Optional commercial customer key (leave blank for public endpoint):
OPEN_METEO_API_KEY=

# --- Road Routing & OSRM Engine ---
# OSRM public router is pre-configured with zero credentials needed:
# Default: https://router.project-osrm.org
OSRM_ROUTER_URL=https://router.project-osrm.org

# --- Notification & Dispatch Provider (Optional) ---
# Optional: Resend API key for external email dispatch notifications
RESEND_API_KEY=
